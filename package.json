    "description": "",
    "main": "index.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "copy-files": "copyfiles -u 1 src/CNAME src/*.html src/**/*.html src/**/*.css src/**/*.png src/**/*.ico src/*.webmanifest src/**/.htaccess src/**/*.js node_modules/bootstrap/dist/**/*.* docs/",
        "copy-htaccess": "cp ./src/.htaccess ./docs",
        "clean": "rimraf ./docs",
        "build": "yarn clean && tsc && webpack && yarn copy-files",
        "start": "webpack-dev-server --config webpack.config.mjs",
        "dev": "webpack serve",
        "kill:webpack": "powershell -Command \"$pids = Get-NetTCPConnection -LocalPort 9000 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess; if ($pids) { $pids | ForEach-Object { Stop-Process -Id $_ -Force } }\"",
        "screenshot": "node scripts/screenshot.js",
        "screenshot:contract": "node scripts/screenshot.js http://localhost:9000/docs/#/contract/1770 tmp/ui-browser-loop/contract-1770-1920.png --mock-login --selector=#uncontrolled-tab-example --text=\"Nr umowy\" --viewport=1920x1080",
        "screenshot:cleanup": "rimraf ./tmp/ui-browser-loop",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.6.3",
